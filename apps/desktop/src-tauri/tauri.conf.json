{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WisdomWorks",
  "version": "0.1.0",
  "identifier": "app.wisdomworks.desktop",
  "build": {
    "beforeDevCommand": "pnpm vite-dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm vite-build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WisdomWorks",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "transparent": false,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://wisdomworks.vercel.app https://api.anthropic.com https://*.supabase.co https://graph.facebook.com https://api.stripe.com https://api.notion.com https://slack.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'"
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "menuOnLeftClick": false,
      "tooltip": "WisdomWorks — Your AI team"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "notification": {
      "all": true
    },
    "shell": {
      "open": true
    }
  }
}
