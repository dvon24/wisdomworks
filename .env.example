# WisdomWorks Environment Variables
# Copy this file to .env and fill in your values

# Database (Supabase)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/wisdomworks

# Authentication (Entra ID)
AUTH_SECRET=your-auth-secret
AZURE_AD_CLIENT_ID=your-client-id
AZURE_AD_CLIENT_SECRET=your-client-secret
AZURE_AD_TENANT_ID=your-tenant-id

# AI Providers
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key

# NATS
NATS_URL=nats://localhost:4222

# Stripe
STRIPE_SECRET_KEY=your-stripe-secret
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Twilio
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

# Telegram (optional — enables the /api/webhooks/telegram channel)
# Create a bot via BotFather to get the token; set the webhook URL with
# `secret_token=<TELEGRAM_WEBHOOK_SECRET>` to lock down the endpoint.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Story 6.1 — Owner API authentication (deadbolt)
# API_AUTH_SECRET: HMAC secret used to sign deck session tokens.
#   Generate with: openssl rand -hex 32
# OWNER_API_TOKEN: optional admin override Bearer token; used by server-
#   to-server scripts (admin/health-check, regenerate-org-doc).
API_AUTH_SECRET=
OWNER_API_TOKEN=

# Square Appointments (optional — enables /api/oauth/square + customer sync)
# Get from https://developer.squareup.com/apps
# SQUARE_ENV: 'sandbox' for testing, 'production' for live merchants.
SQUARE_APP_ID=
SQUARE_APP_SECRET=
SQUARE_ENV=sandbox

# Calendly (optional — enables /api/oauth/calendly + invitee sync)
# Get from https://calendly.com/integrations/api_webhooks → Create app
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=

# Mindbody (optional — partner-app approval required)
# Apply at https://developers.mindbodyonline.com → submit app for review
# Approval ~2 weeks. Until then, MINDBODY_API_KEY stays empty.
MINDBODY_API_KEY=
MINDBODY_PARTNER_NAME=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-key
